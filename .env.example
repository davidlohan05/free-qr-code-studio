# Server-only Supabase project configuration
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
IP_HASH_SALT=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Public canonical URL, e.g. https://freeqrcodestudio.com
PUBLIC_BASE_URL=https://YOUR_DOMAIN

# Optional ad configuration. Keep disabled until your publisher account is approved.
ADS_ENABLED=false
ADS_NETWORK_SCRIPT_URL=
ADS_PUBLISHER_ID=
